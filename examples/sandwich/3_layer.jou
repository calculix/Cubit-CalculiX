#!cubit
reset
create brick x 200 y 8 z 50
webcut volume 1 with plane yplane offset 3
webcut volume 1 with plane yplane offset -3

imprint vol all
merge vol all
vol all size auto factor 5
curve 35 26 43 interval 2
curve 35 26 43 scheme equal
mesh vol all

unmerge vol all

block 1 add vol 1
block 1 name "bottom"
block 2 add vol 2
block 2 name "top"
block 3 add vol 3
block 3 name "core"

ccx import materiallibrary name "steel_S235_DNV2013" groupname "Example Materials RSMITH/Steel" cubit_name "steel_S235_DNV2013"
ccx import materiallibrary name "EN_AW_5083_H111" groupname "Example Materials RSMITH/Aluminium" cubit_name "EN_AW_5083_H111"
ccx import materiallibrary name "rubber_65ShoreA" groupname "Example Materials RSMITH/Rubber" cubit_name "rubber_65ShoreA"
modify material "steel_S235_DNV2013" scalar_properties "CCX_PLASTIC_USE_CARD" 0
modify material "EN_AW_5083_H111" scalar_properties "CCX_PLASTIC_USE_CARD" 0

ccx create section solid block 1 material 1
ccx create section solid block 2 material 2
ccx create section solid block 3 material 3

topology check coincident node volume all tolerance 1.0e-6 draw brief result group
group 2 remove node all with x_coord=-100
ccx create constraint equation name "layer" group_id 2 tolerance 1e-5 dof_1 dof_2 dof_3

create displacement name 'fix' on surface 16 23 21  dof 1 dof 2 dof 3 fix 0 
sideset 1 add surface 13 26 19  
sideset 1 name "load"
ccx create surfacetraction sideset 1 force_dof_1 0 force_dof_2 -1000 force_dof_3 0 name "Load"

ccx create fieldoutput name "fo_1" node
ccx modify fieldoutput 1 node
ccx modify fieldoutput 1 node key_on RF U 
ccx modify fieldoutput 1 node key_off CP DEPF DEPT DTF HCRI KEQ MACH MAXU MF NT PNT POT PRF PS PSF PT PTF PU RFL SEN TS TSF TT TTF TURB V VF 
ccx create fieldoutput name "fo_2" element
ccx modify fieldoutput 2 element
ccx modify fieldoutput 2 element key_on E S 
ccx modify fieldoutput 2 element key_off CEEQ ECD EMFB EMFE ENER ERR HER HFL HFLF MAXE MAXS ME PEEQ PHS SF SMID SNEG SPOS SVF SDV THE ZZS 

ccx create step name "step_1" static
ccx modify step 1 parameter nlgeom_yes
ccx modify step 1 static totaltimeatstart 0 initialtimeincrement 0.1 timeperiodofstep 1 maximumtimeincrement 0.1

ccx step 1 add load surfacetraction 1
ccx step 1 add bc displacement 1
ccx step 1 add fieldoutput 1
ccx step 1 add fieldoutput 2

ccx create job name "sandwich"
#ccx run job 1



