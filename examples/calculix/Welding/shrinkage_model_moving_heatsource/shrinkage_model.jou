# the model is a rebuild of https://github.com/calculix/CalculiX-Examples/tree/master/Thermal/Thermal%20distortion but without contact definitions
# improved with film, radiation and moving heatsource
# you will have to play a lot with the heatflux, meshsize and increments to get a more realistic model

#!cubit
reset

#{tf = 10e-3}
#{bf = 100e-3}
#{length = 500e-3}
#{tw = 10e-3}
#{hw = 100e-3}
#{a = 7e-3}
#{dls = 25e-3}

# flange
create brick x {bf} y {tf} z {length/2}
# web
create brick x {tw/2} y {hw} z {length/2}
# seam
create brick x {a/sqrt(2)} y {a/sqrt(2)} z {length/2-dls}
webcut volume 3 with plane xplane offset 0 rotate 45 about z center 0 0 0  
delete volume 3
compress

#move to position
move Vertex 7  location 0 0 0 include_merged 
move Vertex 15  location 0 {tf} 0 include_merged 
move Vertex 18  location {tw/2} {tf} 0 include_merged 


#we will first merge all together and mesh and then unmerge the web and the flange
imprint vol all
merge vol all
#vol all size auto factor 7
mesh vol all
#unmerge all
unmerge vol all
#reconnect with seam
merge vol 1 3
merge vol 2 3

#create blocks
block 1 add volume 1
block 1 name "flange"
block 2 add volume 2
block 2 name "web"
block 3 add volume 3
block 3 name "seam"

#block all element type hex8
#ccx block all element_type C3D8R
#hex 20 is way more accurate, you can play with the auto size factor and hex8 to see the difference
block all element type hex20 
# hex20 will be c3d20 but can also be modified
ccx block all element_type C3D20R

# create nodesets for boundary conditions
nodeset 1 add surface 10 4  
nodeset 1 name "symm_x"
nodeset 2 add surface 2 8 16  
nodeset 2 name "symm_z"
nodeset 3 add vertex 7  
nodeset 3 name "fixed_y"
nodeset 4 add volume 3
nodeset 4 name "seam_temp"
nodeset 5 add volume all
nodeset 5 name "initial_temp"

#material
ccx units system "N-mm-s"
ccx units geometry unit "m"
ccx create material "X5CrNi189"
ccx modify material 1 add card density model default
ccx modify material 1 card density row 1 values 7910 293.15 unit "SI"
ccx modify material 1 card density row 2 values 7880 363.15 unit "SI"
ccx modify material 1 card density row 3 values 7840 473.15 unit "SI"
ccx modify material 1 card density row 4 values 7790 593.15 unit "SI"
ccx modify material 1 card density row 5 values 7740 703.15 unit "SI"
ccx modify material 1 card density row 6 values 7690 813.15 unit "SI"
ccx modify material 1 card density row 7 values 7640 923.15 unit "SI"
ccx modify material 1 card density row 8 values 7590 1033.15 unit "SI"
ccx modify material 1 card density row 9 values 7540 1143.15 unit "SI"
ccx modify material 1 add card conductivity model iso
ccx modify material 1 card conductivity row 1 values 11.63 293.15 unit "SI"
ccx modify material 1 card conductivity row 2 values 15 473.15 unit "SI"
ccx modify material 1 card conductivity row 3 values 17.5 673.15 unit "SI"
ccx modify material 1 card conductivity row 4 values 18 873.15 unit "SI"
ccx modify material 1 add card elastic model iso
ccx modify material 1 card elastic row 1 values 199000000000 0.28 297.15 unit "SI"
ccx modify material 1 card elastic row 2 values 187000000000 0.3 473.15 unit "SI"
ccx modify material 1 card elastic row 3 values 169000000000 0.28 703.15 unit "SI"
ccx modify material 1 card elastic row 4 values 163000000000 0.28 753.15 unit "SI"
ccx modify material 1 card elastic row 5 values 153000000000 0.29 863.15 unit "SI"
ccx modify material 1 card elastic row 6 values 143000000000 0.28 973.15 unit "SI"
ccx modify material 1 card elastic row 7 values 127000000000 0.25 1093.15 unit "SI"
ccx modify material 1 add card expansion model iso
ccx modify material 1 card expansion row 1 values 1.63e-05 373.15 unit "SI"
ccx modify material 1 card expansion row 2 values 1.71e-05 573.15 unit "SI"
ccx modify material 1 card expansion row 3 values 1.8e-05 773.15 unit "SI"
ccx modify material 1 card expansion row 4 values 1.9e-05 973.15 unit "SI"
ccx modify material 1 card expansion row 5 values 2e-05 1073.15 unit "SI"
ccx modify material 1 card expansion reference temperature 293.15 unit "SI"
ccx modify material 1 add card plastic model iso
ccx modify material 1 card plastic row 1 values 550000000 0 293.15 unit "SI"
ccx modify material 1 card plastic row 2 values 670000000 0.0966332 293.15 unit "SI"
ccx modify material 1 card plastic row 3 values 1000000000 0.394975 293.15 unit "SI"
ccx modify material 1 card plastic row 4 values 1015000000 0.494899 293.15 unit "SI"
ccx modify material 1 card plastic row 5 values 995000000 0.805 293.15 unit "SI"
ccx modify material 1 card plastic row 6 values 500000000 0 373.15 unit "SI"
ccx modify material 1 card plastic row 7 values 570000000 0.0970918 373.15 unit "SI"
ccx modify material 1 card plastic row 8 values 700000000 0.296429 373.15 unit "SI"
ccx modify material 1 card plastic row 9 values 790000000 0.495969 373.15 unit "SI"
ccx modify material 1 card plastic row 10 values 820000000 0.595816 373.15 unit "SI"
ccx modify material 1 card plastic row 11 values 825000000 0.695791 373.15 unit "SI"
ccx modify material 1 card plastic row 12 values 820000000 0.815816 373.15 unit "SI"
ccx modify material 1 card plastic row 13 values 410000000 0 473.15 unit "SI"
ccx modify material 1 card plastic row 14 values 510000000 0.0971823 473.15 unit "SI"
ccx modify material 1 card plastic row 15 values 620000000 0.296575 473.15 unit "SI"
ccx modify material 1 card plastic row 16 values 680000000 0.496243 473.15 unit "SI"
ccx modify material 1 card plastic row 17 values 705000000 0.596105 473.15 unit "SI"
ccx modify material 1 card plastic row 18 values 705000000 0.806105 473.15 unit "SI"
ccx modify material 1 card plastic row 19 values 410000000 0 573.15 unit "SI"
ccx modify material 1 card plastic row 20 values 510000000 0.0971823 573.15 unit "SI"
ccx modify material 1 card plastic row 21 values 620000000 0.296575 573.15 unit "SI"
ccx modify material 1 card plastic row 22 values 680000000 0.496243 573.15 unit "SI"
ccx modify material 1 card plastic row 23 values 705000000 0.596105 573.15 unit "SI"
ccx modify material 1 card plastic row 24 values 705000000 0.806105 573.15 unit "SI"
ccx modify material 1 card plastic row 25 values 410000000 0 673.15 unit "SI"
ccx modify material 1 card plastic row 26 values 510000000 0.0971823 673.15 unit "SI"
ccx modify material 1 card plastic row 27 values 620000000 0.296575 673.15 unit "SI"
ccx modify material 1 card plastic row 28 values 680000000 0.496243 673.15 unit "SI"
ccx modify material 1 card plastic row 29 values 705000000 0.596105 673.15 unit "SI"
ccx modify material 1 card plastic row 30 values 705000000 0.806105 673.15 unit "SI"
ccx modify material 1 card plastic row 31 values 400000000 0 773.15 unit "SI"
ccx modify material 1 card plastic row 32 values 475000000 0.0970405 773.15 unit "SI"
ccx modify material 1 card plastic row 33 values 530000000 0.196698 773.15 unit "SI"
ccx modify material 1 card plastic row 34 values 600000000 0.396262 773.15 unit "SI"
ccx modify material 1 card plastic row 35 values 645000000 0.695981 773.15 unit "SI"
ccx modify material 1 card plastic row 36 values 665000000 0.805857 773.15 unit "SI"
ccx modify material 1 card plastic row 37 values 340000000 0 873.15 unit "SI"
ccx modify material 1 card plastic row 38 values 420000000 0.0972549 873.15 unit "SI"
ccx modify material 1 card plastic row 39 values 500000000 0.296732 873.15 unit "SI"
ccx modify material 1 card plastic row 40 values 515000000 0.496634 873.15 unit "SI"
ccx modify material 1 card plastic row 41 values 530000000 0.696536 873.15 unit "SI"
ccx modify material 1 card plastic row 42 values 545000000 0.806438 873.15 unit "SI"
ccx modify material 1 card plastic row 43 values 270000000 0 973.15 unit "SI"
ccx modify material 1 card plastic row 44 values 350000000 0.0975524 973.15 unit "SI"
ccx modify material 1 card plastic row 45 values 400000000 0.197203 973.15 unit "SI"
ccx modify material 1 card plastic row 46 values 450000000 0.396853 973.15 unit "SI"
ccx modify material 1 card plastic row 47 values 460000000 0.596783 973.15 unit "SI"
ccx modify material 1 card plastic row 48 values 470000000 0.806713 973.15 unit "SI"
ccx modify material 1 card plastic row 49 values 210000000 0 1073.15 unit "SI"
ccx modify material 1 card plastic row 50 values 255000000 0.0979921 1073.15 unit "SI"
ccx modify material 1 card plastic row 51 values 295000000 0.297677 1073.15 unit "SI"
ccx modify material 1 card plastic row 52 values 315000000 0.59752 1073.15 unit "SI"
ccx modify material 1 card plastic row 53 values 330000000 0.807402 1073.15 unit "SI"
ccx modify material 1 add card specific_heat model default
ccx modify material 1 card specific_heat row 1 values 456 293.15 unit "SI"
ccx modify material 1 card specific_heat row 2 values 490 363.15 unit "SI"
ccx modify material 1 card specific_heat row 3 values 532 473.15 unit "SI"
ccx modify material 1 card specific_heat row 4 values 557 593.15 unit "SI"
ccx modify material 1 card specific_heat row 5 values 574 703.15 unit "SI"
ccx modify material 1 card specific_heat row 6 values 586 813.15 unit "SI"
ccx modify material 1 card specific_heat row 7 values 599 923.15 unit "SI"
ccx modify material 1 card specific_heat row 8 values 620 1033.15 unit "SI"
ccx modify material 1 card specific_heat row 9 values 645 1143.15 unit "SI"

#sections
ccx create section solid block all material 1

#moving heatsource
create vertex 10e-3 15e-3 0
create vertex 10e-3 15e-3 225e-3
create curve vertex 34 35
curve 53 size 3e-3
mesh curve 53

ccx create trajectory bodyheatfluxsphere  curve 53  vertex 34  surface 15  direction -1 -1 0 magnitude 5e+7 5e+6  time_begin 0 time_end 10 radius 5e-3 10e-3 depth 5e-3 10e-3  name "heatsource"

sideset 1 Surface 18 15 17 21 16 8 2 10 4 3 6 11 1 7 
ccx create film sideset 1 temperature 20 coefficient 15 name "convection"
ccx create radiation sideset 1 temperature 20 emissivity 0.5 cavity_radiation_off name "radiation"

ccx modify physicalconstants absolute_zero -273.15 stefan_boltzmann 5.669E-8

#boundary conditions
ccx create temperature nodeset 5 magnitude 20 #will be used as initial condition
ccx create displacement nodeset 1 dof_1 0 dof_6 0 #x symm
ccx create displacement nodeset 2 dof_3 0 dof_4 0 #z symm
ccx create displacement nodeset 3 dof_2 0 dof_5 0 #fixed point in y

#initial conditions
ccx create initialcondition temperature
ccx modify initialcondition 1 temperature bc_id 1

#outputs
ccx create fieldoutput name "fo_node" node
ccx modify fieldoutput 1 node frequency 2
ccx modify fieldoutput 1 node key_on U NT
ccx modify fieldoutput 1 node key_off CP DEPF DEPT DTF HCRI KEQ MACH MAXU MF PNT POT PRF PS PSF PT PTF PU RF RFL SEN TS TSF TT TTF TURB V VF 
ccx create fieldoutput name "fo_element" element
ccx modify fieldoutput 2 element frequency 2
ccx modify fieldoutput 2 element key_on E S HFL
ccx modify fieldoutput 2 element key_off CEEQ ECD EMFB EMFE ENER ERR HER HFLF MAXE MAXS ME PEEQ PHS SF SMID SNEG SPOS SVF SDV THE ZZS 

# add homogeneous bc
ccx hbc add bc displacement 1
ccx hbc add bc displacement 2
ccx hbc add bc displacement 3

# create step
ccx create step name "welding" coupledtemperaturedisplacement
ccx modify step 1 parameter inc 100000
ccx modify step 1 coupledtemperaturedisplacement solver pardiso
ccx modify step 1 coupledtemperaturedisplacement totaltimeatstart 0 initialtimeincrement 1e-1 timeperiodofstep 10 minimumtimeincrement 1e-6 maximumtimeincrement 1e-1
ccx step 1 add load trajectory 1
ccx step 1 add fieldoutput 1
ccx step 1 add fieldoutput 2

ccx create step name "cooling" coupledtemperaturedisplacement
ccx modify step 2 parameter inc 100000
ccx modify step 2 coupledtemperaturedisplacement solver pardiso
ccx modify step 2 coupledtemperaturedisplacement totaltimeatstart 10 initialtimeincrement 10 timeperiodofstep 1000 minimumtimeincrement 1e-5 maximumtimeincrement 10
ccx step 2 add load film 1
ccx step 2 add load radiation 1
ccx step 2 add fieldoutput 1
ccx step 2 add fieldoutput 2

#job
ccx create job name "shrinkage_model"
#ccx run job 1
#ccx wait job 1
#post open ccx job 1

ccx draw load trajectory 1

