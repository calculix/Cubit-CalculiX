#!cubit
reset
create brick x 20 y 1 z 5
create brick x 20 y 1 z 5
create brick x 20 y 1 z 5
create brick x 20 y 1 z 5
move vol 1 y 1.5
move vol 2 y 0.5
move vol 3 y -0.5
move vol 4 y -1.5
vol all size auto factor 5
mesh vol all
topology check coincident node volume all tolerance 1.0e-6 draw brief result group 

ccx create constraint equation name "layer" group_id 2 tolerance 1e-5 dof_1 dof_2 dof_3

export ccx "test.inp" overwrite
