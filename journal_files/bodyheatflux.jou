#!cubit
reset
create brick x 1
create brick x 1
move vol 2 x 2
#block 1 add vol 1
vol all size auto factor 5
mesh vol all
block 1 vol 1
block 2 vol 2

#material
ccx units system "N-mm-s"
ccx units geometry unit "mm"
ccx create material "steel"
ccx modify material 1 add card elastic model iso
ccx modify material 1 card elastic row 1 values 210000000000 0.3 273.15 unit "SI"
ccx modify material 1 add card density model default
ccx modify material 1 card density row 1 values 7900 273.15 unit "SI"
ccx modify material 1 add card specific_heat model default
ccx modify material 1 card specific_heat row 1 values 500 273.15 unit "SI"
ccx modify material 1 add card expansion model iso
ccx modify material 1 card expansion row 1 values 1.2e-05 273.15 unit "SI"
ccx modify material 1 add card conductivity model iso
ccx modify material 1 card conductivity row 1 values 50 273.15 unit "SI"

ccx create section solid block all material 1

ccx create bodyheatflux 1000 block 1 name "test" 
ccx create bodyheatflux -1000 element 1001 1002 1003 1004 1005 name "test2" 

#boundary conditions
nodeset 1 add volume all
ccx create temperature nodeset 1 magnitude 293 #will be used as initial condition

#initial conditions
ccx create initialcondition temperature
ccx modify initialcondition 1 temperature bc_id 1


ccx create step name "bodyheatflux" heattransfer
ccx modify step 1 parameter inc 100000
ccx modify step 1 heattransfer  totaltimeatstart 0 initialtimeincrement 1e+1 timeperiodofstep 1000 minimumtimeincrement 1e-5 maximumtimeincrement 1e+1
ccx step 1 add load bodyheatflux 1 2
ccx create fieldoutput name "fo" node
ccx modify fieldoutput 1 node
ccx modify fieldoutput 1 node key_on NT
ccx modify fieldoutput 1 node key_off U RF CP DEPF DEPT DTF HCRI KEQ MACH MAXU MF PNT POT PRF PS PSF PT PTF PU RFL SEN TS TSF TT TTF TURB V VF 
ccx create fieldoutput name "eo" element
ccx modify fieldoutput 2 element
ccx modify fieldoutput 2 element key_on HFL
ccx modify fieldoutput 2 element key_off E S CEEQ ECD EMFB EMFE ENER ERR HER HFLF MAXE MAXS ME PEEQ PHS SF SMID SNEG SPOS SVF SDV THE ZZS 
ccx step 1 add fieldoutput 1
ccx step 1 add fieldoutput 2

ccx create job name "bodyheatflux"

#export ccx "bodyheatflux.inp" overwrite

