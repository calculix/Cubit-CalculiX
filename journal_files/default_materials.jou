#!cubit
# Populate an empty Framework material library; run only against an empty library.
# Source: https://github.com/rsmith-nl/calculix-templates/tree/main/materials
# Original example groups declare SI units; every numeric command below states SI.
# Explicit temperature zero remains zero kelvin; no unit inference is performed.
reset

ccx create materiallibrary group name "Example Materials RSMITH"
ccx modify materiallibrary group name "Example Materials RSMITH" description "https://github.com/rsmith-nl/calculix-templates/tree/main/materials"
ccx create materiallibrary group name "Example Materials RSMITH/Aluminium"
ccx modify materiallibrary group name "Example Materials RSMITH/Aluminium" description "SI Units"
ccx create materiallibrary group name "Example Materials RSMITH/Ceramics"
ccx modify materiallibrary group name "Example Materials RSMITH/Ceramics" description "SI Units"
ccx create materiallibrary group name "Example Materials RSMITH/Metal Alloys"
ccx modify materiallibrary group name "Example Materials RSMITH/Metal Alloys" description "SI Units"
ccx create materiallibrary group name "Example Materials RSMITH/Rubber"
ccx modify materiallibrary group name "Example Materials RSMITH/Rubber" description "SI Units"
ccx create materiallibrary group name "Example Materials RSMITH/Steel"
ccx modify materiallibrary group name "Example Materials RSMITH/Steel" description "SI Units"

