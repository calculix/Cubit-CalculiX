# Prepare development files inside the selected build tree when configuring a
# fresh build. Runtime DLLs continue to come from Cubit's installation.
get_filename_component(_cubit_vtk_default_source "${CMAKE_CURRENT_LIST_DIR}/../../../VTK-9.4.2" ABSOLUTE)
get_filename_component(_cubit_vtk_tools "${CMAKE_CURRENT_LIST_DIR}/../../tools/vtk" ABSOLUTE)
set(VTK_SOURCE_DIR "${_cubit_vtk_default_source}" CACHE PATH "Public VTK 9.4.2 sources used for the Cubit SDK")
set(CUBIT_VTK_SDK_DIR "" CACHE PATH "Prepared development adapter for Cubit's VTK 9.4.2 DLLs")
set(CUBIT_VTK_SETTINGS_FILE "${_cubit_vtk_tools}/settings.example.json" CACHE FILEPATH "Header configuration for Cubit's VTK runtime")

if(WIN32)
  if(NOT CUBIT_VTK_SDK_DIR)
    set(CUBIT_VTK_SDK_DIR "${CMAKE_BINARY_DIR}/vtk-sdk" CACHE PATH "Prepared development adapter for Cubit's VTK 9.4.2 DLLs" FORCE)
  endif()
  if(TARGET VTK::CommonCore OR TARGET VTK::CommonDataModel)
    message(FATAL_ERROR "Load CubitVtkSDK before importing any other VTK SDK.")
  endif()
  if(CMAKE_BUILD_TYPE STREQUAL "Debug")
    message(FATAL_ERROR "Cubit's release VTK SDK requires a release configuration.")
  endif()
  if(NOT EXISTS "${CUBIT_VTK_SDK_DIR}/cubit-vtk-sdk.cmake")
    if(NOT MSVC OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
      message(FATAL_ERROR "Preparing Cubit's VTK development files requires an MSVC-compatible x64 toolchain.")
    endif()
    if(NOT EXISTS "${VTK_SOURCE_DIR}/CMake/vtkVersion.cmake")
      message(FATAL_ERROR "VTK 9.4.2 sources were not found at ${VTK_SOURCE_DIR}. Set VTK_SOURCE_DIR to their location.")
    endif()
    if(NOT EXISTS "${CUBIT_VTK_SETTINGS_FILE}")
      message(FATAL_ERROR "Missing VTK header configuration: ${CUBIT_VTK_SETTINGS_FILE}")
    endif()
    find_package(Python3 3.8 REQUIRED COMPONENTS Interpreter)
    set(_cubit_vtk_librarian "${CMAKE_AR}")
    if(NOT EXISTS "${_cubit_vtk_librarian}")
      get_filename_component(_cubit_vtk_compiler_bin "${CMAKE_CXX_COMPILER}" DIRECTORY)
      set(_cubit_vtk_librarian "${_cubit_vtk_compiler_bin}/lib.exe")
    endif()
    if(NOT EXISTS "${_cubit_vtk_librarian}")
      message(FATAL_ERROR "Cannot find the selected MSVC toolchain's lib.exe.")
    endif()
    set(_cubit_vtk_report "${CUBIT_VTK_SDK_DIR}/host-inspection.json")
    message(STATUS "Preparing VTK development files from ${VTK_SOURCE_DIR}")
    execute_process(
      COMMAND "${Python3_EXECUTABLE}" -B "${_cubit_vtk_tools}/inspect_cubit_vtk.py"
        --cubit-root "${CUBIT_ROOT}" --output "${_cubit_vtk_report}"
      RESULT_VARIABLE _cubit_vtk_inspect_status)
    if(NOT _cubit_vtk_inspect_status STREQUAL "0")
      message(FATAL_ERROR "Cubit VTK inspection failed. See the output above.")
    endif()
    set(_cubit_vtk_prepare_command
      "${Python3_EXECUTABLE}" -B "${_cubit_vtk_tools}/prepare_cubit_vtk_sdk.py"
      --source "${VTK_SOURCE_DIR}" --report "${_cubit_vtk_report}"
      --settings "${CUBIT_VTK_SETTINGS_FILE}" --output "${CUBIT_VTK_SDK_DIR}"
      --lib-exe "${_cubit_vtk_librarian}" --cmake "${CMAKE_COMMAND}" --execute)
    if(CMAKE_GENERATOR_INSTANCE)
      list(APPEND _cubit_vtk_prepare_command --generator-instance "${CMAKE_GENERATOR_INSTANCE}")
    endif()
    if(CMAKE_GENERATOR_TOOLSET)
      list(APPEND _cubit_vtk_prepare_command --toolset "${CMAKE_GENERATOR_TOOLSET}")
    endif()
    execute_process(COMMAND ${_cubit_vtk_prepare_command} RESULT_VARIABLE _cubit_vtk_prepare_status)
    if(NOT _cubit_vtk_prepare_status STREQUAL "0")
      message(FATAL_ERROR "VTK development-file preparation failed. See the output above; no replacement runtime is built.")
    endif()
  endif()
  include("${CUBIT_VTK_SDK_DIR}/cubit-vtk-sdk.cmake")
  if(NOT CUBIT_VTK_SDK_VERSION VERSION_EQUAL "9.4.2")
    message(FATAL_ERROR "The prepared Cubit VTK SDK must be version 9.4.2.")
  endif()
  get_filename_component(_cubit_vtk_host "${CUBIT_VTK_SDK_HOST_ROOT}" REALPATH)
  get_filename_component(_cubit_selected_host "${CUBIT_ROOT}" REALPATH)
  if(NOT _cubit_vtk_host STREQUAL _cubit_selected_host)
    message(FATAL_ERROR "The VTK SDK was prepared for a different CUBIT_ROOT.")
  endif()
  if(VTK_SOURCE_DIR)
    get_filename_component(_cubit_selected_source "${VTK_SOURCE_DIR}" REALPATH)
    get_filename_component(_cubit_sdk_source "${CUBIT_VTK_SDK_SOURCE_ROOT}" REALPATH)
    if(NOT _cubit_selected_source STREQUAL _cubit_sdk_source)
      message(FATAL_ERROR "VTK_SOURCE_DIR differs from the prepared SDK's source tree.")
    endif()
  else()
    set(VTK_SOURCE_DIR "${CUBIT_VTK_SDK_SOURCE_ROOT}" CACHE PATH "Public VTK 9.4.2 sources used for the Cubit SDK" FORCE)
  endif()
  foreach(_cubit_vtk_target VTK::CommonCore VTK::CommonDataModel VTK::IOXML VTK::IOParallelXML)
    if(NOT TARGET ${_cubit_vtk_target})
      message(FATAL_ERROR "Prepared SDK does not define ${_cubit_vtk_target}.")
    endif()
    get_target_property(_cubit_vtk_implib ${_cubit_vtk_target} IMPORTED_IMPLIB)
    if(NOT EXISTS "${_cubit_vtk_implib}")
      message(FATAL_ERROR "Missing prepared import library: ${_cubit_vtk_implib}")
    endif()
  endforeach()
  message(STATUS "Using Cubit's VTK 9.4.2 DLLs; C++ compatibility is ${CUBIT_VTK_SDK_COMPATIBILITY}. Use Release; step-4 tests remain required.")
else()
  # The PE/import-library preparation helper is Windows-only. Linux requires
  # an explicit host-compatible SDK supplied through VTK_DIR, never a fallback.
  if(NOT VTK_DIR)
    message(FATAL_ERROR "Set VTK_DIR to an explicit Cubit-compatible VTK 9.4.2 development SDK on Linux.")
  endif()
  find_package(VTK 9.4.2 EXACT CONFIG REQUIRED COMPONENTS CommonCore CommonDataModel IOXML IOParallelXML PATHS "${VTK_DIR}" NO_DEFAULT_PATH)
endif()
