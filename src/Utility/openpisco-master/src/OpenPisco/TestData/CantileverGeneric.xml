<data dim="3" debug="True">
    <Plugins>
       <Plugin name="OpenPisco.Optim.Algorithms.OptimAlgoNullSpace" load="true" />
    </Plugins>

    <Zones>
        <AABox id="1" origin="-0.25 0.05 0.05" size="2.5 0.4 0.9"/>
        <Plane id="2" point="1.9 0. 0." normal="-1. 0. 0."/>
        <Cylinder id="3" center1="-0.5 0.25 0.5" center2="0.5 0.25 0.5" radius="0.05"/>
        <Union id="4" z="2 3"/>
        <Union id="5" z="1 4"/>
    </Zones>

    <Grids>
        <Grid id="1" n="41 11 21" origin="0. 0. 0." length="2.0 0.5 1.0"/>
    </Grids>

    <LevelSets>
        <LevelSet id="1" support="1"/>
    </LevelSets>

    <PhysicalProblems>
        <StructuredFEA id="1" grid="1" type="disp" eVoid="0.001" linearSolver="EigenCG">
             <Dirichlet zone="2" dofs="0 1 2" val="0.0"/>
             <Neumann   zone="3" dofs="2" val="1000"/>
        </StructuredFEA>
    </PhysicalProblems>


    <OptimProblems>
        <OptimProblem type="TopoGeneric" id="1"
            OnZone="4" Dirichlet="2" Neumann="3"
            useLevelset="1"
    	    e2="0.001"
            output="1"
            outputEveryLevelsetUpdate="False"
        >
          <Objective  type="Compliance"  name="Compliance" useProblem="1" />
          <Constraint type="Volume"     name="Volume"   UpperBound="0.5" />
       </OptimProblem>
    </OptimProblems>

    <TopologicalOptimizations>
        <OptimAlgoNullSpace id="1"
            useOptimProblem="1"
            alphaC="0.5"
            K="0.1"
            stepSizeMax="1"
            stepSize="0.1"
        />
    </TopologicalOptimizations>

    <Outputs>
       <Output id="1" name="CantileverGeneric.xdmf"/>
    </Outputs>

    <Actions>
        <Action type="InitLevelset" ls="1" zone="5"/>
        <Action type="UpdateDistance" ls="1" />
        <Action type="RunTopoOp" TopoOp="1"/>
    </Actions>
 </data>
