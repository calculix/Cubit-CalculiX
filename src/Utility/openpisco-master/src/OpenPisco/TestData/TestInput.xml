  </OptimProblems>

  <TopologicalOptimizations>
    <OptimAlgoUnconstrained id="1" useOptimProblem="1" addInequalityConstraintsConstribution="True" numberOfDesignStepsMax="1400"
     numberOfIterationsMax="20" automaticPenalisation="True" />
  </TopologicalOptimizations>

  <Outputs>
    <Output id="1" name="Basic.xdmf" inTempDirectory="True" />
  </Outputs>

  <Actions>
    <Action type="InitLevelset" ls="1" zone="4" />
    <Action type="RunTopoOp" TopoOp="1" />
  </Actions>

</data>
