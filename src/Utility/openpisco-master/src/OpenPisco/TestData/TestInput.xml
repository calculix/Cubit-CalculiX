<data dim="3" debug="false" xmlns:xi="http://www.w3.org/2001/XInclude">
  <Plugins>
    <Plugin name="OpenPisco.TestData.TestPlugin" load="true" />
    <Plugin name="OpenPisco.TestData.NonExistentPlugin" load="false" />
  </Plugins>

  <xi:include href="zones.xml" />

  <Grids>
    <Grid id="1" n="25 26 27" origin="-0.5 -0.75 -0.5" length="1. 1.5 1." />
