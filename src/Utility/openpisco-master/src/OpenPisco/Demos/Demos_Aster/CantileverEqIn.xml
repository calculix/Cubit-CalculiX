<!--
Minimization of the elastic compliance of a cantilever beam under volume equality constraint
Computation on half domain
-->

<data dim="3" debug="False" >

    <Zones>
        <Plane id="2" point="0.0001 0.25 0.5" normal="1. 0. 0."/>
        <Plane id="3" point="0.05 0.25 0.5" normal="1. 0. 0."/>
        <Plane id="9" point="1. 0.24999 0.5" normal="0. -1. 0."/>
        <Cylinder id="4" center1="1.9999 0.25 0.5" center2="2.1 0.25 0.5" radius="0.01"/>
        <Cylinder id="5" center1="1.9 0.25 0.5" center2="2.1 0.25 0.5" radius="0.05"/>
        <Cylinder id="6" center1="-0.1 0.25 0.5" center2="2.1 0.25 0.5" radius="0.249"/>
        <Union id="7" z="3 5 6"/>
        <Union id="8" z="3 5"/>
    </Zones>

    <Grids>
        <Grid id="1" n="40 40 40" origin="0. 0. 0." length="2.0 0.25 1.0" ofTetras ="True"/>
    </Grids>


    <LevelSets>
        <LevelSet id="1" support="1" conform="True" gradientMethod="gradPhi">
              <MesherInfo hmax="0.04" hmin="0.02" hausd="0.02" hgrad="1.2" rmc="1e-5" nr="True" iso="0.0" computeDistanceWith="meshdist" keepGeneratedFiles="True"/>
        </LevelSet>
    </LevelSets>

    <PhysicalProblems>
        <GeneralAster type="static_elastic" id="1" >
                  <Material  young="1." poisson="0.3" />
                  <Dirichlet eTag="ET2" dofs="0 1 2" value="0.0"/>
                  <Dirichlet eTag="ET9" dofs="1" value="0.0"/>
                  <Force eTag="ET4" value="0. 0. -.5"/>
         </GeneralAster>
    </PhysicalProblems>

    <OptimProblems>
        <OptimProblem type="TopoGeneric" id="1"
            OnZone="8"
            useLevelset="1"
            e2 = "0.01"
	    printMeshQualityInfo = "True"
            output="3"
            outputEveryLevelsetUpdate = "False">
          <Objective  type="Volume"  name="Volume"/>
          <Constraint type="Compliance"  name="Compliance" TargetValue="5.e-5"  useProblem="1" />
          <Constraint type="VonMises"  name="VonMises" UpperBound="4.31058585e+02"  useProblem="1" />
       </OptimProblem>
    </OptimProblems>
    <TopologicalOptimizations>
        <OptimAlgoNullSpace id="1"
            useOptimProblem="1"
            numberOfDesignStepsMax="100"
            numberOfIterationsMax="20"
            alphaC="1."
            alphaJ=".1"
            stepSizeMax="0.005"
            stepSize="0.003"
	    tol_merit="0.0001"
        />

    </TopologicalOptimizations>

    <Outputs>
       <Output id="1" name="CantileverEqInHistory.xmf" inTempDirectory="True" />
       <Output id="2" name="CantileverEqInHistory.csv" inTempDirectory="True" />
       <Output id="3" name="PROXY" outputs="1 2" />
    </Outputs>

    <Actions>
        <Action type="InitLevelset" ls="1" zone="5"/>
        <Action type="AddEdges" ls="1" ar="45" />
        <Action type="AddSkin" ls="1"/>
        <Action type="CreateTagsFromZones" ls="1" elementTags="2 4 9" dim="2"/>
        <Action type= "SetAsRequired" ls="1" eTags="ET4" />
        <Action type="Remesh" ls="1" iso="0.0" hausd="0.06" hmin="0.06"
          hmax="0.09" nr="True" computeDistanceWith="meshdist"/>
        <Action type= "ChangePhiByZones" ls="1" zone="7" />
        <Action type="Remesh" ls="1" iso="0.0" hausd="0.06" hmin="0.06"
          hmax="0.09" nr="True" computeDistanceWith="meshdist"/>
        <Action type="RunTopoOp" TopoOp="1"/>
        <Action type="MirrorLevelSet" ls="1" Y="0.25"/>
        <Action type="SaveShapeToFile" ls="1" filename="CantileverEqIn.stl"/>
	<Action type="LsQualityInfo" ls="1" />
    </Actions>

 </data>
