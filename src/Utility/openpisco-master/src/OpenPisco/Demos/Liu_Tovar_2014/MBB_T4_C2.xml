    <Zones>
        <AABox id="1" origin="-5.99 -0.99 0.01" size="11.98 1.98 1.98" desc="Init" />
        <!-- to initialise with a gyroid
        <AABox id="10" origin="-5.99 -0.99 0.01" size="11.98 1.98 1.98" desc="Init" />
        <Gyroid id="100"  desc="Init" scale="0.3" />
        <Symmetric id="101" z="100" />
        <Intersection id="1" z="10 101"/>
        -->

        <Cylinder id="20" center1="-6 -1 -0.01" center2="-6 -1 0.02" radius="0.025" desc="block"/>
        <Cylinder id="21" center1="-6  1 -0.01" center2="-6  1 0.02" radius="0.025" desc="block"/>
        <Cylinder id="22" center1=" 6 -1 -0.01" center2=" 6 -1 0.02" radius="0.025" desc="block"/>
        <Cylinder id="23" center1=" 6  1 -0.01" center2=" 6  1 0.02" radius="0.025" desc="block"/>
        <Union id="2" z="20 21 22 23" desc="all blocks"/>

        <Offset id="222" z="2" offset="-0.5" />

        <Cylinder id="3" center1="0 0 1.99" center2="0 0 2.01" radius="0.025" desc="Force"/>
        <Offset id="333" z="3" offset="-0.5" />

        <Union id="44" z="2 3"/>
        <Offset id="4" z="44" offset="-0.1" />
        <Union id="5" z="1 4 222 333"/>
        <Plane id="6"  point="-0.001 0 0" normal="-1 0 0"/>
        <Plane id="7"  point="0 -0.001 0" normal="0 -1 0"/>

    </Zones>

    <Grids>
        <Grid id="1" n="121 21 61" origin="-6. -1. -.5" length="6 1 3"/>
    </Grids>

    <LevelSets>
        <LevelSet id="1" support="1"/>
    </LevelSets>

    <PhysicalProblems>
        <Structured id="1" grid="1" type="static_elastic" >
             <Dirichlet zone="20" dofs="0 1 2" val="0.0"/>
             <Dirichlet zone="21" dofs="0 2" val="0.0"/>
             <Dirichlet zone="22" dofs=" 2" val="0.0"/>
             <Dirichlet zone="23" dofs=" 2" val="0.0"/>

             <Dirichlet zone="6" dofs="0" val="0.0"  />
             <Dirichlet zone="7" dofs="1" val="0.0"  />
             <Neumann   zone="3" dofs="2" val="-1000"/>
        </Structured>
    </PhysicalProblems>


    <OptimProblems>
        <OptimProblem type="TopoGeneric" id="1"
            OnZone="4"
            useLevelset="1"


            output="1"
            outputEveryLevelsetUpdate="False"
        >
          <Objective  type="Compliance"  name="Displacement" useProblem="1" />
          <Constraint type="Volume"     name="Volume"   UpperBound="4.8/2"  desc="0.2*voltotal= 0.2*6*2*2=4.8"/>
       </OptimProblem>

    </OptimProblems>

    <TopologicalOptimizations>
 	<OptimAlgoNullSpace id="1"
            useOptimProblem="1"
        />

    </TopologicalOptimizations>

    <Outputs>
       <Output id="2" name="Liu_Tovar_2014_MBB.xdmf"/>
       <Output id="3" name="Liu_Tovar_2014_MBB.csv" nTag="NT3" />
       <Output id="1" name="PROXY" outputs="2 3"/>
    </Outputs>

    <Actions>
        <Action type="CreateTagsFromZones" ls="1" nodalTags="3" />
        <Action type="InitLevelset" ls="1" zone="5"/>
        <Action type="UpdateDistance" ls="1" />
        <Action type="RunTopoOp" TopoOp="1"/>
        <Action type="MirrorLevelSet" ls="1" X="0" Y="0" />
        <Action type="SaveShapeToFile" ls="1" filename="Liu_Tovar_2014_MBB.stl"/>
    </Actions>
 </data>
