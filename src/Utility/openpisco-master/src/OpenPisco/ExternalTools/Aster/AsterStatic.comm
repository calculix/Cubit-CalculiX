POURSUITE(PAR_LOT='NON')

mesh = LIRE_MAILLAGE(FORMAT='MED')

model = AFFE_MODELE(AFFE=_F(**modelisation),
                    MAILLAGE=mesh)


CHYOUNG = LIRE_CHAMP (
                  UNITE=20,
                  MAILLAGE = mesh,
                  NOM_MED = 'CHYOUNG',
                  TYPE_CHAM = 'CART_NEUT_R',
                  NOM_CMP = 'X1',
                  NOM_CMP_MED='DX',
                  PROL_ZERO = 'OUI',
                  INST=0.0,
                  INFO=1,
)

CHNU = LIRE_CHAMP (
                  UNITE=20,
                  MAILLAGE = mesh,
                  NOM_MED = 'CHNU',
                  TYPE_CHAM = 'CART_NEUT_R',
                  NOM_CMP = 'X1',
                  NOM_CMP_MED='DX',
                  PROL_ZERO = 'OUI',
                  INST=0.0,
                  INFO=1,
)

E_F=DEFI_FONCTION(NOM_PARA='NEUT1',VALE=(-1.0,-1.0,1.0,1.0, ),PROL_DROITE='LINEAIRE',PROL_GAUCHE='LINEAIRE')
NU_F=DEFI_FONCTION(NOM_PARA='NEUT2',VALE=(-1.0,-1.0,1.0,1.0, ),PROL_DROITE='LINEAIRE',PROL_GAUCHE='LINEAIRE')

mater=DEFI_MATERIAU(ELAS_FO=_F(E=E_F, NU=NU_F,),)

fieldmat = AFFE_MATERIAU(AFFE=_F(MATER=(mater, ),
                                 TOUT='OUI'),
                         AFFE_VARC=(
                                    _F(NOM_VARC='NEUT1', CHAM_GD=CHYOUNG,),
                                    _F(NOM_VARC='NEUT2', CHAM_GD=CHNU,),
                                   ),
                         MODELE=model)

conditions = []
for condition in [dirichlet,neumann,forcenodale,bodyforces]:
    if len(list(condition.values())[0]):
        conditions.append(AFFE_CHAR_MECA(MODELE=model, **condition))

if hasPreStress:
    CHSIGM = LIRE_CHAMP (
                    UNITE=20,
                    MAILLAGE = mesh,
                    NOM_MED = 'PreStress',
                    MODELE = model,
                    TYPE_CHAM = 'ELGA_SIEF_R',
                    NOM_CMP_IDEM = 'OUI',
                    PROL_ZERO = 'OUI',
                    INST=0.0,
                    INFO=1,
    )
    conditions.append(AFFE_CHAR_MECA(MODELE=model, PRE_SIGM=_F(SIGM=CHSIGM)))

solveur = _F(METHODE='MUMPS',
             RESI_RELA = resi_rela,
            STOP_SINGULIER='NON',
                      )

excitOp = tuple([_F(CHARGE=condition) for condition in conditions])
reslin = MECA_STATIQUE(CHAM_MATER=fieldmat,
                       EXCIT=excitOp,
                       SOLVEUR=solveur,
                       MODELE=model,
                       )


#=====================================================================================================
#                                      POST PROCESSING
#=====================================================================================================

#=====================================================================================================
#                                    FIELD POST PROCESSING
#=====================================================================================================
dictFields = {'potential_energy':'ENEL_ELGA','stress':'SIEF_ELGA','von_mises':'SIEQ_ELGA',
              'strain':'EPSI_ELGA','strain_buckling':'EPSI_ELGA','strain_green_buckling':'EPSG_ELGA',
              'elastic_energy_buckling':'ENEL_ELGA','zzError':'ERZ1_ELEM'}

for field in fields:
    if field == 'potential_energy':
        reslin = CALC_CHAMP(reuse=reslin,
                    RESULTAT=reslin,
                    ENERGIE=('ENEL_ELGA'),
                    FORCE=('FORC_NODA'))
    elif field == 'stress':
        reslin = CALC_CHAMP(reuse=reslin,
                    CONTRAINTE=('SIEF_ELGA'),
                    RESULTAT=reslin)
    elif field == 'von_mises':
        reslin = CALC_CHAMP(reuse=reslin,
                    CONTRAINTE=('SIEF_ELGA'),
                    CRITERES=('SIEQ_ELGA'),
                    RESULTAT=reslin)
    elif field == 'strain':
        reslin = CALC_CHAMP(reuse=reslin,
                    DEFORMATION=('EPSI_ELGA',),
                    RESULTAT=reslin)
    elif field == 'zzError':
        reslin=CALC_ERREUR(reuse =reslin,
                 RESULTAT=reslin,
                 TOUT_ORDRE='OUI',
                 SOLVEUR=_F(METHODE='MULT_FRONT'),
                 OPTION=('ERZ1_ELEM'),);
        SIGZZ1 = CREA_CHAMP(TYPE_CHAM='ELEM_ERRE_R',
                    OPERATION='EXTR',
                    RESULTAT=reslin,
                    NOM_CHAM='ERZ1_ELEM',
                    NUME_ORDRE=1,);
    else:
        raise Exception('Not implemented for: ',field)

nom_cham_med = [field for field in fields ]
nom_cham     = [dictFields[field] for field in nom_cham_med ]

if 'von_mises' in fields:
    idx = nom_cham_med.index('von_mises')
    nom_cham.pop(idx)
    nom_cham_med.pop(idx)

    IMPR_RESU(FORMAT='MED',UNITE=80,VERSION_MED='4.0.0',
        RESU=(
                _F(RESULTAT=reslin,
                   NOM_CHAM=('SIEQ_ELGA'),
                   NOM_CMP=('VMIS', ),
                   NOM_CHAM_MED=('von_mises'),
                   ),
               ),
            )

if 'zzError' in fields:
      idx = nom_cham_med.index('zzError')
      nom_cham.pop(idx)
      nom_cham_med.pop(idx)

      IMPR_RESU(FORMAT='MED',UNITE=80,VERSION_MED='4.0.0',
          RESU=(
                _F(RESULTAT=reslin,
                   NOM_CHAM=('ERZ1_ELEM'),
                   NOM_CMP=('ERREST', ),
                   NOM_CHAM_MED=('zzError'),
                   ),
               ),
          )

if len(nom_cham_med)>0:
        IMPR_RESU(FORMAT='MED',UNITE=80,VERSION_MED='4.0.0',
            RESU=(
                _F(RESULTAT=reslin,
                        NOM_CHAM     = nom_cham,
                        NOM_CHAM_MED = nom_cham_med,
                       ),
                ),
              )


IMPR_RESU(FORMAT='MED',UNITE=80,VERSION_MED='4.0.0',
        RESU=(
            _F(RESULTAT=reslin,
            NOM_CHAM=('DEPL'),
            NOM_CHAM_MED=('DEPL'),
            ),
        ),)


#==============================================================================================
#                                SCALAR POST PROCESSING
#==============================================================================================

for scalar in scalars:
    if scalar == 'int_potential_energy':
       tab1 =POST_ELEM(RESULTAT=reslin, TRAV_EXT=_F())
    else:print('Not implemented for scalar: ',scalar)
    IMPR_TABLE(TABLE=tab1,FORMAT='TABLEAU',SEPARATEUR=',',TITRE='',UNITE=27)
    DETRUIRE(CONCEPT=_F(NOM=tab1,),)

#===============================================================================================


FIN()
